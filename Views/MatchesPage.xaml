<Page x:Class="Sumos.Views.MatchesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Матчи">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Команда A:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox x:Name="TeamAComboBox" Width="200" Margin="0,0,12,0" DisplayMemberPath="Name" />
            <TextBlock Text="Команда B:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox x:Name="TeamBComboBox" Width="200" DisplayMemberPath="Name" />
            <Button Content="Сгенерировать календарь" Margin="12,0,0,0" Click="GenerateScheduleButton_Click" />
        </StackPanel>

        <GroupBox Grid.Row="1" Header="Результат матча" Margin="0,0,0,8">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Раунды (0/1)" FontWeight="Bold" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Раунд 1:" Width="70" VerticalAlignment="Center" />
                        <TextBox x:Name="Round1ATextBox" Width="40" Margin="0,0,4,0" />
                        <TextBlock Text=":" VerticalAlignment="Center" />
                        <TextBox x:Name="Round1BTextBox" Width="40" Margin="4,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Раунд 2:" Width="70" VerticalAlignment="Center" />
                        <TextBox x:Name="Round2ATextBox" Width="40" Margin="0,0,4,0" />
                        <TextBlock Text=":" VerticalAlignment="Center" />
                        <TextBox x:Name="Round2BTextBox" Width="40" Margin="4,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Раунд 3:" Width="70" VerticalAlignment="Center" />
                        <TextBox x:Name="Round3ATextBox" Width="40" Margin="0,0,4,0" />
                        <TextBlock Text=":" VerticalAlignment="Center" />
                        <TextBox x:Name="Round3BTextBox" Width="40" Margin="4,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0" />

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Нарушения" FontWeight="Bold" Margin="0,0,0,4" />
                    <CheckBox x:Name="WarningsACheckBox" Content="Предупреждения A" Margin="0,0,0,2" />
                    <CheckBox x:Name="WarningsBCheckBox" Content="Предупреждения B" Margin="0,0,0,8" />
                    <CheckBox x:Name="PenaltyToACheckBox" Content="Баллы сопернику A" Margin="0,0,0,2" />
                    <CheckBox x:Name="PenaltyToBCheckBox" Content="Баллы сопернику B" Margin="0,0,0,8" />
                    <CheckBox x:Name="DisqualifyACheckBox" Content="Дисквалификация A" Margin="0,0,0,2" />
                    <CheckBox x:Name="DisqualifyBCheckBox" Content="Дисквалификация B" Margin="0,0,0,2" />
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="8,0,0,0">
                    <TextBlock Text="Доп. решение" FontWeight="Bold" Margin="0,0,0,4" />
                    <ComboBox x:Name="DecisionComboBox" Margin="0,0,0,4">
                        <ComboBoxItem Content="Авто по раундам" IsSelected="True" />
                        <ComboBoxItem Content="Доп. раунд - победа A" />
                        <ComboBoxItem Content="Доп. раунд - победа B" />
                        <ComboBoxItem Content="Решение жюри - победа A" />
                        <ComboBoxItem Content="Решение жюри - победа B" />
                        <ComboBoxItem Content="Ничья" />
                    </ComboBox>
                    <TextBlock Text="Причина дисквалификации:" Margin="0,4,0,2" />
                    <TextBox x:Name="DisqualificationReasonTextBox"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="60" />
                    <Button Content="Завершить матч"
                            Margin="0,8,0,0"
                            Height="30"
                            Click="FinishMatchButton_Click" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <DataGrid Grid.Row="2"
                  x:Name="MatchesGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  LoadingRow="MatchesGrid_LoadingRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Тур" Binding="{Binding RoundNumber}" Width="*" />
                <DataGridTextColumn Header="Команда A" Binding="{Binding TeamANameSnapshot}" Width="2*" />
                <DataGridTextColumn Header="Команда B" Binding="{Binding TeamBNameSnapshot}" Width="2*" />
                <DataGridTextColumn Header="Счёт" Binding="{Binding ScoreText}" Width="*" />
                <DataGridTextColumn Header="Итог" Binding="{Binding ResultText}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>


<Page x:Class="Sumos.Views.TeamsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Команды">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid x:Name="TeamsGrid"
                  Grid.Row="0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="0,0,0,8"
                  SelectionChanged="TeamsGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Участник" Binding="{Binding Participant}" Width="2*" />
                <DataGridTextColumn Header="Масса (г)" Binding="{Binding RobotWeight}" Width="*" />
                <DataGridTextColumn Header="Конструктор" Binding="{Binding Constructor}" Width="*" />
                <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TeamNameTextBox" Grid.Column="0" Margin="0,0,4,0" ToolTip="Название команды" />
                <TextBox x:Name="ParticipantTextBox" Grid.Column="1" Margin="0,0,4,0" ToolTip="ФИО участника" />
                <TextBox x:Name="WeightTextBox" Grid.Column="2" Margin="0,0,4,0" ToolTip="1-1000 г" />
                <ComboBox x:Name="ConstructorComboBox" Grid.Column="3" Margin="0,0,8,0">
                    <ComboBoxItem Content="LEGO" />
                    <ComboBoxItem Content="VEX" />
                    <ComboBoxItem Content="Arduino" />
                    <ComboBoxItem Content="Другое" />
                </ComboBox>
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button x:Name="AddTeamButton" Content="Добавить" Width="90" Margin="0,0,4,0" Click="AddTeamButton_Click" />
                    <Button x:Name="EditTeamButton" Content="Редактировать" MinWidth="120" Padding="10,6" Margin="0,0,4,0" Click="EditTeamButton_Click" />
                    <Button x:Name="DeleteTeamButton" Content="Удалить" Width="80" Click="DeleteTeamButton_Click" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="0,6,0,0" Padding="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Изменить статус команды (при ошибке заполнения):" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="DisqualifyCheckBox" Content="Команда дисквалифицирована" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="Причина:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox x:Name="DisqualificationReasonTextBox" Width="250" ToolTip="Причина дисквалификации (сохраняется при нажатии Редактировать)" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>


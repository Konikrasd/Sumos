<Page x:Class="Sumos.Views.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Отчёты">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid x:Name="ReportsGrid"
                  Grid.Row="0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Margin="0,0,0,8"
                  RowHeight="56"
                  CanUserResizeRows="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Матч" Binding="{Binding MatchSummary}" Width="3*" />
                <DataGridTemplateColumn Header="Протокол" Width="5*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Details}"
                                       TextWrapping="Wrap"
                                       Padding="4,2"
                                       VerticalAlignment="Top" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Экспорт JSON" Margin="0,0,8,0" Width="110" Click="ExportJsonButton_Click" />
            <Button Content="Экспорт CSV" Width="110" Click="ExportCsvButton_Click" />
        </StackPanel>
    </Grid>
</Page>


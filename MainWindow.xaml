<Window x:Class="Sumos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sumos"
        mc:Ignorable="d"
        Title="Интеллектуальное сумо 15x15"
        Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <!-- Верхняя панель -->
        <Border DockPanel.Dock="Top"
                Background="#01939A"
                CornerRadius="8"
                Padding="10"
                Margin="0,0,0,8">
            <DockPanel>
                <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                    <TextBlock Text="Интеллектуальное сумо 15x15"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource BlackTextBrush}" />
                    <TextBlock Text="Система учёта турнира"
                               FontSize="12"
                               Foreground="{StaticResource BlackTextBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right"
                            Margin="16,0,0,0">
                    <Button Content="Команды" Click="OpenTeamsPage_Click" />
                    <Button Content="Матчи" Click="OpenMatchesPage_Click" />
                    <Button Content="Рейтинг" Click="OpenRatingPage_Click" />
                    <Button Content="Спарринги" Click="OpenSchedulePage_Click" />
                    <Button Content="Отчёты" Click="OpenReportsPage_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Основная область -->
        <Border CornerRadius="10"
                Background="{StaticResource CardBrush}"
                Padding="8">
            <Frame x:Name="MainFrame"
                   NavigationUIVisibility="Hidden"
                   Background="Transparent" />
        </Border>

        <!-- Статусбар -->
        <StatusBar DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Готово" />
            </StatusBarItem>
        </StatusBar>
    </DockPanel>
</Window>
